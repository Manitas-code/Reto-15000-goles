{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "contracts/**/*.ts"
  ],
  "exclude": [
    "tests",
    "node_modules",
    "dist",
    "dist-server"
  ]
}
