# Server-only. Copy to .env and supply the existing public/anon key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-existing-public-key
PORT=3001
HOST=127.0.0.1
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SERVE_WEB=false
WEB_BASE_PATH=/
SUPABASE_TIMEOUT_MS=10000
# Optional for separately hosted API; default same-origin /api/v1.
# VITE_API_BASE_URL=https://api.example.com/api/v1

# Docker Compose: host ports; internal API port stays 3001.
# DEV_WEB_PORT=5173
# DEV_API_PORT=3001
# PROD_PORT=3001
# PROD_BIND_ADDRESS=127.0.0.1
# Compose uses WEB_BASE_PATH for both the web build and runtime prefix.
