{
  "name": "goalday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2 <1.5"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun scripts/build.mjs",
    "preview": "bun --bun run vite preview",
    "typecheck": "bun --bun run tsc --noEmit && bun --bun run tsc --noEmit -p tsconfig.server.json",
    "lint": "bun --bun run eslint .",
    "format:check": "bun --bun run prettier --check \"src/**/*.{ts,tsx}\" \"contracts/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\"",
    "test": "bun --bun run vitest run --exclude tests/unit/stadium-geometry.test.ts && bun run test:stadiums",
    "e2e": "bun --bun run playwright test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "dev:web": "bun --bun run vite",
    "dev:server": "bun --watch server/start.ts",
    "build:web": "bun scripts/build.mjs web",
    "build:server": "bun scripts/build.mjs server",
    "smoke:server": "bun scripts/smoke-server.mjs",
    "start": "bun dist-server/server/start.js",
    "test:stadiums": "node node_modules/vitest/vitest.mjs run tests/unit/stadium-geometry.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "packageManager": "bun@1.4.2"
}
