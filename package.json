{
  "name": "goalday",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"contracts/**/*.ts\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"*.config.ts\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:web": "vite",
    "dev:server": "tsx watch --env-file-if-exists=.env server/start.ts",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "smoke:server": "node scripts/smoke-server.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server/start.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.1",
    "@testing-library/react": "^16.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.12.0",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.5",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
